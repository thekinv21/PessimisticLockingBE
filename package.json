{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "Vadim",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun src/main.ts",
    "lint": "oxlint --type-aware src/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepare": "husky",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:generate": "bunx --bun prisma generate",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bunx --bun prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "3",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11",
    "@nestjs/platform-socket.io": "^11",
    "@nestjs/swagger": "11",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.6",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^11",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "1.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
