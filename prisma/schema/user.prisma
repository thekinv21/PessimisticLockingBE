model User {
  id           String      @id @default(cuid())
  fullName     String
  email        String      @unique
  password     String
  tokenVersion Int         @default(0)
  avatar       String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  roles        UserRoles[]
  posts        Post[]
}
